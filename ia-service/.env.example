# ===== ia-service (FastAPI + YOLO) — configuración local =====
# Copia este archivo a .env (ignorado por git) y ajusta los valores.
# Las variables de entorno del proceso tienen prioridad sobre este archivo.

# Entorno de ejecución. En "production" la autenticación pasa a ser OBLIGATORIA:
# si falta VISION_IA_KEY el servicio falla cerrado (503) en vez de exponer
# inferencia abierta.
VISION_ENV="development"

# Secreto compartido con el backend. Debe ser EXACTAMENTE el mismo valor que
# VISION_IA_KEY en backend/.env. Se compara en tiempo constante y nunca se loguea.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si se deja vacío en development el servicio responde abierto (solo red interna).
VISION_IA_KEY=""

# Ruta al checkpoint. Por defecto apunta al modelo oficial V3 versionado.
# Rutas relativas se resuelven respecto a la raíz de ia-service.
VISION_MODEL_PATH="models/repuestopro_yolo11n_v3_webcam_robust.pt"

# Dispositivo de inferencia: "cpu" o el índice de GPU ("0", "cuda:0").
# "cpu" funciona en cualquier máquina y es lo más seguro para una demo local.
# El Dockerfile del proyecto también usa "cpu".
VISION_DEVICE="cpu"

# Límite técnico de píxeles de una imagen decodificada (anti image-bomb).
VISION_MAX_IMAGE_PIXELS="40000000"

# Predicción sintética al arrancar para absorber la inicialización de Torch.
# Evita que el primer request real supere el timeout de 8 s del backend.
VISION_WARMUP="true"
