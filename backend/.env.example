DATABASE_URL="postgresql://user:password@localhost:5432/inventario_db?schema=public"
JWT_SECRET="tu-secreto-jwt-aqui"
PORT=3000
FRONTEND_URL="http://localhost:5173"
MOBILE_URL="http://localhost:19006"

# ===== Búsqueda por visión (IA) =====
# VISION_MODE: "http" (modelo real, valor por defecto) | "mock" (detecciones
# simuladas, solo para pruebas automatizadas).
# - "http" sin VISION_IA_URL NO degrada a mock: el endpoint responde
#   503 VISION_NO_DISPONIBLE para no entregar detecciones falsas.
# - En producción, sin VISION_MODE y sin VISION_IA_URL, ocurre lo mismo
#   (falla cerrado). El mock en producción solo ocurre si se fija a mano.
# - Si VISION_MODE no se define y VISION_IA_URL sí, se usa "http" automáticamente.
# Cada respuesta incluye proveedor="http" o proveedor="mock" para que el
# cliente nunca confunda una simulación con una inferencia real.
VISION_MODE="http"
# URL base del servicio de visión (ia-service, FastAPI + YOLO).
# Local: http://127.0.0.1:8000. Endpoint esperado:
# <VISION_IA_URL>/vision/detect (POST multipart, campo "image").
VISION_IA_URL=""
# Timeout máximo (ms) de la llamada al modelo. Valores menores a 500 se redondean a 500.
VISION_TIMEOUT_MS="8000"
# Confianza mínima (0..1) para aceptar una detección. Por debajo responde 422.
VISION_CONFIDENCE_MIN="0.55"
# Secreto compartido con ia-service: el backend lo envía en el header `X-Vision-Key`
# y el servicio lo exige en /vision/detect y /vision/classify (comparación en tiempo
# constante). Mismo valor en el entorno de ia-service.
# Sin valor: en desarrollo el servicio responde abierto (solo red interna privada);
# con VISION_ENV=production en ia-service, el servicio falla cerrado (503).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VISION_IA_KEY=""
