DATABASE_URL="postgresql://user:password@localhost:5432/inventario_db?schema=public"
JWT_SECRET="tu-secreto-jwt-aqui"
PORT=3000
FRONTEND_URL="http://localhost:5173"
MOBILE_URL="http://localhost:19006"

# ===== Búsqueda por visión (IA) =====
# VISION_MODE: "mock" (detección simulada, desarrollo/demo) | "http" (modelo real).
# Si VISION_IA_URL está definida se usa "http" automáticamente.
# Sin configuración en producción queda en modo MOCK: se loguea una advertencia al
# arrancar y cada respuesta incluye proveedor="mock" para que nunca se haga pasar por real.
VISION_MODE="mock"
# URL base del servicio de visión (p. ej. el backend FastAPI con el modelo YOLO de Erika).
# Endpoint esperado: <VISION_IA_URL>/vision/detect (POST multipart, campo "image").
VISION_IA_URL=""
# Timeout máximo (ms) de la llamada al modelo. Valores menores a 500 se redondean a 500.
VISION_TIMEOUT_MS="8000"
# Confianza mínima (0..1) para aceptar una detección. Por debajo responde 422.
VISION_CONFIDENCE_MIN="0.55"
