{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "snapshot_id",
    "original_inventory_sha256",
    "original_files",
    "processing_version",
    "script",
    "script_sha256",
    "parameters",
    "executed_at",
    "outputs",
    "source_manifest_path"
  ],
  "properties": {
    "schema_version": {
      "const": "curated-manifest-1"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "original_inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "original_format",
          "file_size_bytes",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "original_format": {
            "type": "string",
            "minLength": 1
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "processing_version": {
      "type": "string",
      "minLength": 1
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parameters": {
      "type": "object"
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "original_format",
          "file_size_bytes",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "original_format": {
            "type": "string",
            "minLength": 1
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "source_manifest_path": {
      "type": "string",
      "minLength": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
