{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "source_url",
    "provider",
    "obtained_at",
    "license",
    "license_url",
    "geographic_scope",
    "currency",
    "units",
    "description",
    "schema_version",
    "source_id",
    "name",
    "snapshot_id",
    "registered_at",
    "raw_root",
    "commercial_use_allowed",
    "original_filename",
    "original_format",
    "sha256",
    "hash_scope",
    "inventory_sha256",
    "file_size_bytes",
    "file_count",
    "files",
    "temporal_coverage",
    "intended_use",
    "limitations",
    "processing_status",
    "notes",
    "completeness",
    "contains_archives",
    "documentation_files",
    "evidence",
    "visible_structure",
    "archive_inspection"
  ],
  "properties": {
    "domain": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "uri"
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "obtained_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "date-time"
    },
    "license": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "license_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "format": "uri"
    },
    "geographic_scope": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "units": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "schema_version": {
      "const": "source-manifest-1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_root": {
      "type": "string",
      "pattern": "^sources/external_raw/"
    },
    "commercial_use_allowed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "original_filename": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "original_format": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hash_scope": {
      "enum": [
        "FILE_BYTES",
        "FILE_INVENTORY_SHA256"
      ]
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file_size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relative_path",
          "original_format",
          "file_size_bytes",
          "sha256"
        ],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "original_format": {
            "type": "string",
            "minLength": 1
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    },
    "temporal_coverage": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "precision",
        "basis"
      ],
      "properties": {
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "DAY",
            "MONTH",
            "YEAR",
            "UNKNOWN"
          ]
        },
        "basis": {
          "enum": [
            "LOCAL_DOCUMENTATION",
            "VERIFIED_DATA",
            "OFFICIAL_DOCUMENTATION"
          ]
        }
      }
    },
    "intended_use": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "processing_status": {
      "enum": [
        "RAW_REGISTERED",
        "PENDING_SOURCE_REVIEW",
        "APPROVED_FOR_PROFILING",
        "CURATED",
        "REJECTED"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completeness": {
      "enum": [
        "UNKNOWN",
        "INCOMPLETE",
        "VERIFIED_COMPLETE"
      ]
    },
    "contains_archives": {
      "type": "boolean"
    },
    "documentation_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "scope",
          "finding"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visible_structure": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "archive_inspection": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status",
          "entries"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "entries": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "license_status": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNKNOWN",
        "RESTRICTED"
      ]
    },
    "academic_use_status": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNKNOWN",
        "RESTRICTED"
      ]
    },
    "commercial_use_status": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNKNOWN",
        "RESTRICTED"
      ]
    },
    "redistribution_status": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNKNOWN",
        "RESTRICTED"
      ]
    },
    "verification_status": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNKNOWN",
        "RESTRICTED"
      ]
    },
    "acquisition_verification_status": {
      "enum": [
        "VERIFIED",
        "PARTIALLY_VERIFIED",
        "UNKNOWN",
        "RESTRICTED"
      ]
    },
    "official_name": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation": {
      "type": [
        "string",
        "null"
      ]
    },
    "citation_required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "obtained_from_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "granularity": {
      "type": "string"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_type": {
      "type": "string"
    },
    "real_or_synthetic": {
      "enum": [
        "REAL",
        "REAL_DERIVED",
        "SYNTHETIC",
        "MIXED",
        "UNKNOWN"
      ]
    },
    "intended_role_v2": {
      "type": "array",
      "items": {
        "enum": [
          "DIRECT_DOMAIN_REFERENCE",
          "DEMAND_PATTERN_REFERENCE",
          "PRICE_PATTERN_REFERENCE",
          "STORE_PATTERN_REFERENCE",
          "PROMOTION_REFERENCE",
          "WHOLESALE_PATTERN_REFERENCE",
          "CANCELLATION_REFERENCE",
          "CALENDAR_REFERENCE",
          "NOT_SUITABLE"
        ]
      }
    },
    "profiling_decision": {
      "enum": [
        "APPROVED_ACADEMIC_ONLY",
        "BLOCKED_LICENSE",
        "BLOCKED_ACCESS_CONFIRMATION"
      ]
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subdatasets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "hash_semantics": {
      "type": "object"
    },
    "related_publications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "paper_review_note": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
