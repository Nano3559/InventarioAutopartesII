# ==========================================
# SERVICIO IA - DATASETS
# ==========================================

# Ignorar datasets, excepto manifiestos
/ia-service/datasets/*
!/ia-service/datasets/dataset_manifest.csv

# Dataset de revisión
!/ia-service/datasets/review/
/ia-service/datasets/review/images/
/ia-service/datasets/review/labels/
!/ia-service/datasets/review/review_manifest.csv

# Dataset de anotación
!/ia-service/datasets/annotation_batch/
/ia-service/datasets/annotation_batch/images/
/ia-service/datasets/annotation_batch/labels/
!/ia-service/datasets/annotation_batch/annotation_batch_manifest.csv

# ==========================================
# SERVICIO IA - RESULTADOS Y EXPERIMENTOS
# ==========================================
/ia-service/runs/
/ia-service/weights/
/ia-service/artifacts/
/ia-service/diagnostics/

# Experimentos locales de entrenamiento y evaluación
# Incluye los experimentos fallidos de V4
/ia-service/experiments/

# ==========================================
# DATASETS Y RESULTADOS GLOBALES
# ==========================================
/dataset/
/datasets/
/runs/
/weights/

# ==========================================
# SERVICIO IA - IMÁGENES Y ETIQUETAS
# ==========================================
/ia-service/**/*.jpg
/ia-service/**/*.jpeg
/ia-service/**/*.png
/ia-service/**/*.webp
/ia-service/**/*.bmp
/ia-service/**/*.tiff
/ia-service/**/labels/

# ==========================================
# MODELOS DE INTELIGENCIA ARTIFICIAL
# ==========================================

# Ignorar pesos y modelos exportados
*.pt
*.onnx

# Excepción: checkpoint oficial YOLO11n V3
!ia-service/models/repuestopro_yolo11n_v3_webcam_robust.pt

# ==========================================
# CREDENCIALES Y TOKENS
# ==========================================
**/kaggle.json
.kaggle/
**/*access_token*
**/*access-token*

# ==========================================
# PYTHON
# ==========================================
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class

# Cachés de herramientas Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Entorno virtual de anotación
/ia-service/.annotation-venv/

